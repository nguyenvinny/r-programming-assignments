> #2.Lattice Graphics
> library(lattice)
> satgpa$sex_label <- factor(satgpa$sex, levels = c(1, 2), labels = c("Male", "Female"))
> # Conditional scatter plot (small multiples)
> xyplot(fy_gpa ~ sat_sum | factor(sex_label),
+        data=satgpa,
+        main="1st Year GPA vs. SAT Score by Sex",
+        xlab="SAT Score",
+        ylab="1st Year GPA",
+        pch    = 19,
+        alpha  = 0.4,
+        layout = c(2, 1),
+        type   = c("p", "r", "g"),
+        groups=sex_label,
+        par.settings = list(
+          superpose.symbol = list(col = c("steelblue", "firebrick"), pch = 19),
+          superpose.line   = list(col = c("steelblue", "firebrick"))
+        ))
> # Box-and-whisker plot
> bwplot(hs_gpa ~ factor(sex_label),
+        data=satgpa,
+        main="High School GPA by Sex",
+        xlab="Sex",
+        ylab="High School GPA",
+        pch    = "|",
+        fill   = "steelblue",
+        par.settings = list(box.rectangle = list(col = "black"),
+                            box.umbrella  = list(col = "black")))
> 
> #3.ggplot2
> library(ggplot2)
> # Scatter plot with smoothing
> ggplot(satgpa, aes(x=sat_sum, y=fy_gpa, color=factor(sex_label))) +
+   geom_point(alpha=0.4) +
+   geom_smooth(method="lm") +
+   labs(title="1st Year GPA vs. SAT Score with trend by Sex",
+        x="SAT Score",
+        y="1st Year GPA",
+        color="Sex") +
+   theme_minimal() +
+   scale_color_manual(values = c("Male" = "steelblue", "Female" = "firebrick"))
`geom_smooth()` using formula = 'y ~ x'
> # Faceted histogram
> ggplot(satgpa, aes(x=hs_gpa, fill=sex_label)) +
+   geom_histogram(binwidth=0.25, color="white") +
+   facet_wrap(~ sex_label) +
+   labs(title="High School GPA distribution by Sex",
