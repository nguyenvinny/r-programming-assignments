> # 1) Matrix Addition & Subtraction
> A <- matrix(c(2, 0, 1, 3), ncol = 2)
> B <- matrix(c(5, 2, 4, -1), ncol = 2)
> 
> A
     [,1] [,2]
[1,]    2    1
[2,]    0    3
> B
     [,1] [,2]
[1,]    5    4
[2,]    2   -1
> 
> A + B
     [,1] [,2]
[1,]    7    5
[2,]    2    2
> A - B
     [,1] [,2]
[1,]   -3   -3
[2,]   -2    4
